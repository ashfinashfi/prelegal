# Prelegal Environment Configuration Template

# OpenRouter API Key for AI Scribe Contract Generation
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Model Slug (Free Tier Models: openai/gpt-oss-20b:free, meta-llama/llama-3.3-70b-instruct:free, etc.)
OPENROUTER_MODEL=openrouter/openai/gpt-oss-20b:free

# Secret Key for JWT Authentication Signatures (Change to a secure random 64-char string in production)
SECRET_KEY=dev-secret-key-change-in-production

# Environment Mode: development | production | test
ENVIRONMENT=development

# Database Connection URL (Defaults to persistent SQLite under data directory)
DATABASE_URL=sqlite:///./data/prelegal.db

# Optional Cookie Security Override (true/false)
COOKIE_SECURE=false
